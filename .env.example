# Copia este archivo como .env y llena los valores. El .env nunca se sube a git.

PORT=5000
MONGO_URI=
JWT_SECRET=
FRONTEND_URL=

# Google Calendar (cuenta de servicio en google-credentials.json)
ID_CALENDARIO=

# Cloudinary (fotos de servicios y productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo con Gmail. GMAIL_APP_PASSWORD es una "contraseña de aplicación" de
# Google (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas
# de aplicaciones), no la contraseña normal de la cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Correo del negocio: recibe los avisos de citas nuevas, movidas y canceladas.
# Si se deja vacío, llegan a GMAIL_USER. La recuperación de contraseña le llega
# directo al correo de cada cliente.
EMAIL_USER=

# Opcional: webhook para avisos (Make, Zapier)
WEBHOOK_URL=
